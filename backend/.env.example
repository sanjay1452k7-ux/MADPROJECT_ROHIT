# Copy to .env and fill in. Never commit the filled-in file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/cit_attendance?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# QR validity window in seconds (Section 19: 20-30s).
ATTENDANCE_TOKEN_TTL_SECONDS=25

INSTITUTION_EMAIL_DOMAIN="citchennai.net"
ATTENDANCE_THRESHOLD_PERCENT=75

PORT=3000

# Comma-separated origins allowed to call the API from a browser. Left unset,
# cross-origin requests are refused entirely - the Android client is not a
# browser and does not need CORS.
CORS_ALLOWED_ORIGINS=
