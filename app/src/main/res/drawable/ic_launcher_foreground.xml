<?xml version="1.0" encoding="utf-8"?>
<!--
  Original CIT emblem: an abstract hexagonal "aperture" mark.
  Deliberately generic-institutional geometry - not a reproduction of any real crest.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer hexagon shield -->
    <path
        android:pathData="M54,26 L74,37.5 L74,60.5 L54,72 L34,60.5 L34,37.5 Z"
        android:strokeColor="#B57BFF"
        android:strokeWidth="3.2"
        android:fillColor="#00000000"
        android:strokeLineJoin="round" />

    <!-- Inner monogram stroke: stylised C -->
    <path
        android:pathData="M62,44 A11,11 0 1,0 62,58"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />

    <!-- Accent bar -->
    <path
        android:pathData="M54,78 L54,82"
        android:strokeColor="#7C3AED"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
</vector>
