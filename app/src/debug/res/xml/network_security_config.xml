<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  Cleartext is permitted so a handset can reach a development server, whether
  that is tunnelled over USB (adb reverse, 127.0.0.1) or reached directly on the
  local network by IP. Release builds carry no cleartext exception at all: they
  use HTTPS and Android's default policy blocks anything else, which is why the
  lint warning is suppressed here rather than in the shipped configuration.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
