<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Cleartext is permitted solely for the loopback addresses an
  emulator or a device-on-the-same-machine uses to reach a local development
  server. Release builds carry no cleartext exception at all.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
